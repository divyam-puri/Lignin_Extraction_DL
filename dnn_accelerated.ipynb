if CUPY_OK:
    @cuda.jit
    def _kernel_impute(X, col_means):
        r, c = cuda.grid(2)
        if r < X.shape[0] and c < X.shape[1]:
            if math.isnan(X[r, c]):
                X[r, c] = col_means[c]

    def gpu_apply_impute(X_np, cm):
        X_gpu = cuda.to_device(X_np.astype(np.float32))
        m_gpu = cuda.to_device(cm.astype(np.float32))
        r, c  = X_np.shape; tpb = (16, 16)
        bpg   = (math.ceil(r/tpb[0]), math.ceil(c/tpb[1]))
        _kernel_impute[bpg, tpb](X_gpu, m_gpu)
        cuda.synchronize()
        return X_gpu.copy_to_host()

    def gpu_tta_noise(X_np, sigma, rng):
        noise = rng.randn(*X_np.shape).astype(np.float32) * sigma
        X_d   = cuda.to_device(X_np.astype(np.float32))
        N_d   = cuda.to_device(noise)
        r, c  = X_np.shape; tpb = (16, 16)
        bpg   = (math.ceil(r/tpb[0]), math.ceil(c/tpb[1]))
        @cuda.jit
        def _k(X, N):
            i, j = cuda.grid(2)
            if i < X.shape[0] and j < X.shape[1]:
                X[i, j] += N[i, j]
        _k[bpg, tpb](X_d, N_d)
        cuda.synchronize()
        return X_d.copy_to_host()
else:
    def gpu_apply_impute(X_np, cm):
        X = X_np.copy().astype(np.float32)
        for j in np.where(np.isnan(X).any(axis=0))[0]:
            X[np.isnan(X[:, j]), j] = float(cm[j])
        return X

    def gpu_tta_noise(X_np, sigma, rng):
        return (X_np + rng.randn(*X_np.shape).astype(np.float32) * sigma)


# ══════════════════════════════════════════════════════════════════════════════
# DNN ARCHITECTURES
# ══════════════════════════════════════════════════════════════════════════════
class ResBlock(nn.Module):
    def __init__(self, dim, dropout):
        super().__init__()
        self.block = nn.Sequential(
            nn.LayerNorm(dim), nn.Linear(dim, dim*2), nn.GELU(),
            nn.Dropout(dropout), nn.Linear(dim*2, dim), nn.Dropout(dropout))
    def forward(self, x):
        return x + self.block(x)

class ResidualMLP(nn.Module):
    """Standard residual MLP — same as v4."""
    def __init__(self, n_in, hidden, depth, dropout):
        super().__init__()
        self.input_bn   = nn.BatchNorm1d(n_in)
        self.input_proj = nn.Sequential(
            nn.Linear(n_in, hidden), nn.LayerNorm(hidden), nn.GELU(), nn.Dropout(dropout))
        self.blocks = nn.ModuleList([ResBlock(hidden, dropout) for _ in range(depth)])
        self.head   = nn.Sequential(
            nn.LayerNorm(hidden), nn.Linear(hidden, hidden//2), nn.GELU(),
            nn.Dropout(dropout*0.5), nn.Linear(hidden//2, 1))
        self._init_weights()

    def _init_weights(self):
        for m in self.modules():
            if isinstance(m, nn.Linear):
                nn.init.kaiming_normal_(m.weight, nonlinearity="linear")
                if m.bias is not None: nn.init.zeros_(m.bias)

    def forward(self, x):
        x = self.input_bn(x)
        x = self.input_proj(x)
        for b in self.blocks: x = b(x)
        return self.head(x).squeeze(-1)


class ResBlockSiLU(nn.Module):
    """ResBlock with SiLU activation for BottleneckMLP."""
    def __init__(self, dim, dropout):
        super().__init__()
        self.block = nn.Sequential(
            nn.LayerNorm(dim), nn.Linear(dim, dim*2), nn.SiLU(),
            nn.Dropout(dropout), nn.Linear(dim*2, dim), nn.Dropout(dropout))
    def forward(self, x):
        return x + self.block(x)


class BottleneckMLP(nn.Module):
    """
    FIX E: Wide input projection → narrow residual core → output.
    Better for small n tabular: wide first layer captures feature interactions
    before regularizing down to a compact representation.
    Uses SiLU activation throughout for structural diversity from ResidualMLP.
    """
    def __init__(self, n_in, hidden, depth, dropout):
        super().__init__()
        wide = min(hidden * 2, 512)
        self.input_bn   = nn.BatchNorm1d(n_in)
        self.input_proj = nn.Sequential(
            nn.Linear(n_in, wide),   nn.LayerNorm(wide),   nn.SiLU(), nn.Dropout(dropout),
            nn.Linear(wide, hidden), nn.LayerNorm(hidden), nn.SiLU(), nn.Dropout(dropout * 0.7))
        self.blocks = nn.ModuleList([ResBlockSiLU(hidden, dropout) for _ in range(depth)])
        self.head = nn.Sequential(
            nn.LayerNorm(hidden),
            nn.Linear(hidden, hidden // 2), nn.SiLU(),
            nn.Dropout(dropout * 0.5),
            nn.Linear(hidden // 2, hidden // 4), nn.SiLU(),
            nn.Linear(hidden // 4, 1))
        self._init_weights()

    def _init_weights(self):
        for m in self.modules():
            if isinstance(m, nn.Linear):
                nn.init.kaiming_normal_(m.weight, nonlinearity="linear")
                if m.bias is not None: nn.init.zeros_(m.bias)

    def forward(self, x):
        x = self.input_bn(x)
        x = self.input_proj(x)
        for b in self.blocks: x = b(x)
        return self.head(x).squeeze(-1)


class HuberL1Loss(nn.Module):
    def __init__(self, delta=0.5, l1_weight=0.3):
        super().__init__()
        self.delta = delta; self.l1_weight = l1_weight
    def forward(self, p, t):
        return (1 - self.l1_weight) * F.huber_loss(p, t, delta=self.delta) + \
               self.l1_weight * F.l1_loss(p, t)


def build_model(arch, n_in, hidden, depth, dropout):
    """Factory: 'residual' or 'bottleneck'."""
    if arch == "bottleneck":
        return BottleneckMLP(n_in, hidden, depth, dropout).to(DEVICE)
    return ResidualMLP(n_in, hidden, depth, dropout).to(DEVICE)


