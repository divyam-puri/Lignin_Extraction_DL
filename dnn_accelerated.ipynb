# AUGMENTATIONS
# ══════════════════════════════════════════════════════════════════════════════
def mixup_data(X, y, alpha=0.2, rng=None):
    if rng is None: rng = np.random.RandomState(SEED)
    n   = len(X)
    lam = rng.beta(alpha, alpha, n).astype(np.float32)
    idx = rng.permutation(n)
    return (lam[:,None]*X + (1-lam[:,None])*X[idx]).astype(np.float32), \
           (lam*y + (1-lam)*y[idx]).astype(np.float32)

def cutout_batch(X, frac, prob, rng):
    X_out = X.clone(); n, d = X_out.shape; ndrop = max(1, int(d*frac))
    for i in range(n):
        if rng.rand() < prob:
            X_out[i, rng.choice(d, ndrop, replace=False)] = 0.0
    return X_out


