def add_features(df):
    df = df.copy()
    if "temperature_C" in df.columns and "time_hr" in df.columns:
        t  = df["temperature_C"].astype(float)
        hr = df["time_hr"].astype(float)
        if "LogR0" not in df.columns:
            df["LogR0"] = np.log10((hr + 1e-9) * np.exp((t - 100) / 14.75))
        R0 = df["LogR0"]
        df["LogR0_sq"]        = R0 ** 2
        df["LogR0_cb"]        = R0 ** 3
        df["severity_x_time"] = R0 * hr
        df["log_time"]        = np.log1p(hr)
        df["sqrt_time"]       = np.sqrt(hr.clip(0))
        df["temp_sq"]         = t ** 2
        df["temp_x_LogR0"]    = t * R0
        df["temp_x_time"]     = t * hr
        df["inv_temp"]        = 1.0 / (t + 273.15)
        df["inv_LogR0"]       = 1.0 / (R0.abs() + 1e-9)
        df["arrhenius"]       = df["inv_temp"] * R0
        df["exp_sev"]         = np.exp(R0.clip(-5, 5))
        df["R0_sqrt_t"]       = R0 * np.sqrt(hr.clip(0))
        df["R0_over_temp"]    = R0 / (t + 1e-9)
    if "liquid_solid_ratio" in df.columns and "LogR0" in df.columns:
        lsr = df["liquid_solid_ratio"].astype(float); R0 = df["LogR0"]
        t   = df.get("temperature_C", pd.Series(0., index=df.index)).astype(float)
        hr  = df.get("time_hr",       pd.Series(0., index=df.index)).astype(float)
        df["log_LSR"]        = np.log1p(lsr)
        df["LSR_x_LogR0"]    = lsr * R0
        df["LSR_sq"]         = lsr ** 2
        df["LSR_x_temp"]     = lsr * t
        df["LSR_x_time"]     = lsr * hr
        df["LSR_x_inv_temp"] = lsr / (t + 273.15)
        df["LSR_x_R0_sq"]    = lsr * R0 ** 2
        df["LSR_over_temp"]  = lsr / (t + 1e-9)
    if "HBD_HBA_ratio" in df.columns and "LogR0" in df.columns:
        ratio = df["HBD_HBA_ratio"].astype(float)
        df["ratio_x_LogR0"] = ratio * df["LogR0"]
        df["ratio_sq"]      = ratio ** 2
        df["log_ratio"]     = np.log1p(ratio.clip(0))
    if "lignin_percent" in df.columns and "LogR0" in df.columns:
        lig = df["lignin_percent"].astype(float)
        df["lig_x_LogR0"] = lig * df["LogR0"]
        df["lig_sq"]      = lig ** 2
        df["lig_x_R0_sq"] = lig * df["LogR0"] ** 2
        df["log_lig"]     = np.log1p(lig.clip(0))
    if "cellulose_percent" in df.columns and "lignin_percent" in df.columns:
        cel = df["cellulose_percent"].astype(float); lig = df["lignin_percent"].astype(float)
        df["cell_lig_ratio"]  = cel / (lig + 1e-9)
        df["cell_plus_lig"]   = cel + lig
        df["cell_over_total"] = cel / (cel + lig + 1e-9)
    if "hemicellulose_percent" in df.columns and "lignin_percent" in df.columns:
        hemi = df["hemicellulose_percent"].astype(float); lig = df["lignin_percent"].astype(float)
        df["hemi_lig_ratio"] = hemi / (lig + 1e-9)
        if "LogR0" in df.columns: df["hemi_x_R0"] = hemi * df["LogR0"]
    if "HBA-MW" in df.columns and "HBD-MW" in df.columns:
        HBA = df["HBA-MW"].astype(float); HBD = df["HBD-MW"].astype(float)
        df["MW_ratio"] = HBA / (HBD + 1e-9); df["MW_sum"] = HBA + HBD
        df["MW_product"] = HBA * HBD / 1e4
    if "HBA-SLogP" in df.columns and "HBD-SLogP" in df.columns:
        SLA = df["HBA-SLogP"].astype(float); SLB = df["HBD-SLogP"].astype(float)
        df["SLogP_sum"] = SLA + SLB; df["SLogP_diff"] = SLA - SLB
        df["SLogP_product"] = SLA * SLB; df["DES_polarity"] = (SLA + SLB) / 2
    if "HBA-TopoPSA" in df.columns and "HBD-TopoPSA" in df.columns:
        PA = df["HBA-TopoPSA"].astype(float); PB = df["HBD-TopoPSA"].astype(float)
        df["PSA_sum"] = PA + PB; df["PSA_ratio"] = PA / (PB + 1e-9)
        if "LogR0" in df.columns: df["PSA_x_R0"] = df["PSA_sum"] * df["LogR0"]
    if "HBA-nHBAcc" in df.columns and "HBD-nHBDon" in df.columns:
        df["HB_comp"] = df["HBA-nHBAcc"].astype(float) * df["HBD-nHBDon"].astype(float)
    if "HBA-SLogP" in df.columns and "LogR0" in df.columns:
        df["SLogP_HBA_x_R0"] = df["HBA-SLogP"].astype(float) * df["LogR0"]
    if "HBA-SLogP" in df.columns and "liquid_solid_ratio" in df.columns:
        df["SLogP_HBA_x_LSR"] = df["HBA-SLogP"].astype(float) * df["liquid_solid_ratio"].astype(float)
    if "lignin_percent" in df.columns and "liquid_solid_ratio" in df.columns:
        df["lig_x_LSR"] = df["lignin_percent"].astype(float) * df["liquid_solid_ratio"].astype(float)
    if "temperature_C" in df.columns and "liquid_solid_ratio" in df.columns:
        t   = df["temperature_C"].astype(float)
        lsr = df["liquid_solid_ratio"].astype(float)
        df["temp_lsr_interact"] = t * lsr / 1e3
        df["temp_over_lsr"]     = t / (lsr + 1e-9)
    return df

