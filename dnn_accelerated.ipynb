def fit_impute(X):
    return np.nanmean(X, axis=0)

def apply_impute(X, cm):
    return gpu_apply_impute(X, cm)

def fit_scale_xy(X_tr, y_tr):
    return RobustScaler().fit(X_tr), RobustScaler().fit(y_tr.reshape(-1, 1))

def transform_X(sx, X):
    c = sx.center_.astype(np.float32); s = sx.scale_.astype(np.float32)
    return ((X.astype(np.float32) - c) / (s + 1e-9))

def transform_y(sy, y):
    return sy.transform(y.reshape(-1, 1)).flatten().astype(np.float32)

def inv_y(sy, p):
    return np.expm1(sy.inverse_transform(
        np.asarray(p).flatten().reshape(-1, 1)).flatten())

def stratify_labels(y, n_bins=STRAT_BINS):
    bins = np.unique(np.quantile(y, np.linspace(0, 1, n_bins + 1)))
    return np.digitize(y, bins[1:-1])


